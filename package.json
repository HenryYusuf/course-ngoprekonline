{
  "name": "course-ngoprekonline",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "typecheck": "nuxt typecheck",
    "knip": "knip",
    "test": "vitest",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "dependencies": {
    "nuxt": "catalog:prod",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@nuxt/test-utils": "catalog:dev",
    "@unocss/eslint-plugin": "catalog:frontend",
    "@unocss/nuxt": "catalog:frontend",
    "@vue/test-utils": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-slop": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "happy-dom": "catalog:dev",
    "knip": "catalog:dev",
    "nano-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "skills-npm": "catalog:dev",
    "unocss": "catalog:frontend",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "nano-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
